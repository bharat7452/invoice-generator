# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/invoice-generator for local MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/invoice-generator?retryWrites=true&w=majority
# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
